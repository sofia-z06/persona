          "id": "",
          "name": "db"
        }
      },
      "notes": "Partie Sofia (version minimale pour tester). alwaysOutputData doit rester activé : sans session, la requête ne renvoie aucune ligne et le flux s'arrêterait avant le Switch."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
