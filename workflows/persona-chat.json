                    "leftValue": "={{ $json.expires_at }}",
                    "rightValue": "={{ $now }}",
                    "operator": {
                      "type": "dateTime",
                      "operation": "after"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Agent"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallback": "Auth"
        }
