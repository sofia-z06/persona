    {
      "parameters": {
        "jsCode": "// Unified schema: title, url, summary, published_at, source, topic\nreturn $input.all().map(i => {\n  const j = i.json;\n  const src = (typeof j.source === 'object' && j.source) ? j.source.name : j.source;\n  return { json: {\n    title: j.title || '',\n    url: j.link || j.url || '',\n    summary: j.contentSnippet || j.description || '',\n    published_at: j.isoDate || j.publishedAt || null,\n    source: src || 'unknown',\n    topic: j.topic || 'international'\n  } };\n});"
      },
