    {
      "parameters": {
        "jsCode": "const user = $('SEND - Select Articles').first().json;\nconst summaries = Object.fromEntries(\n  $('SEND - Summarize Articles').all().map(i => i.json).filter(a => a && a.id).map(a => [a.id, a.summary])\n);\nconst articles = (user.articles || []).map(a => ({ ...a, summary: summaries[a.id] ?? a.summary }));\nreturn [{ json: { user_id: user.user_id, email: user.email, pseudo: user.pseudo, articles } }];"
      },
