        "operation": "executeQuery",
        "query": "UPDATE users u\nSET last_sent_at = NOW()\nWHERE u.status = 'active'\n  AND u.send_time IS NOT NULL\n  AND cardinality(u.interests) > 0\n  AND MOD(EXTRACT(EPOCH FROM ((NOW() AT TIME ZONE u.timezone)::time - u.send_time))::int + 86400, 86400) < 900\n  AND (u.last_sent_at IS NULL\n       OR (u.last_sent_at AT TIME ZONE u.timezone)::date < (NOW() AT TIME ZONE u.timezone)::date)\nRETURNING u.id AS user_id;",
