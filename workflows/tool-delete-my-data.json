        "operation": "executeQuery",
        "query": "WITH target AS (SELECT id, email FROM users WHERE id = $1),\n   user_sessions AS (SELECT session_id FROM sessions WHERE user_id = $1),\n   del_history AS (DELETE FROM n8n_chat_histories WHERE session_id IN (SELECT session_id FROM user_sessions) OR session_id = $2),\n   del_otp AS (DELETE FROM otp WHERE email IN (SELECT email FROM target)),\n   del_flow AS (DELETE FROM auth_flow WHERE email IN (SELECT email FROM target) OR session_id IN (SELECT session_id FROM user_sessions))\n   DELETE FROM users WHERE id IN (SELECT id FROM target) RETURNING id;",
