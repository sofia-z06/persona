        "query": "WITH invalidated AS (UPDATE otp SET expires_at = NOW() WHERE email = $1 AND expires_at > NOW()) INSERT INTO otp (email, code_hash, expires_at, attempts) VALUES ($1, $2, NOW() + INTERVAL '10 minutes', 0);",
        "options": {
          "queryReplacement": "={{ [$json.email, $json.codeHash] }}"
        }
