    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst { sessionId, chatInput } = $('AUTH - Start').first().json;\nconst { email } = $('DB - Get Auth Flow').first().json;\nconst otp = $input.first().json;\nconst match = String(chatInput ?? '').match(/\\b\\d{6}\\b/);\nconst base = { sessionId, email, otpId: otp.id ?? null };\nif (!match) return [{ json: { ...base, status: 'format' } }];\nif (!otp.id) return [{ json: { ...base, status: 'expired' } }];\nif (otp.attempts >= 3) return [{ json: { ...base, status: 'blocked' } }];\nconst hash = crypto.createHash('sha256').update(match[0]).digest();\nconst stored = Buffer.from(otp.code_hash, 'hex');\nconst ok = stored.length === hash.length && crypto.timingSafeEqual(hash, stored);\nif (ok) return [{ json: { ...base, status: 'valid' } }];\nconst attempts = otp.attempts + 1;\nreturn [{ json: { ...base, status: attempts >= 3 ? 'blocked' : 'invalid', attemptsLeft: 3 - attempts } }];"
      },
