    {
      "parameters": {
        "jsCode": "const input = $('AUTH - Start').first().json;\nconst text = String(input.chatInput ?? '').trim();\nconst match = text.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/);\nconst email = match ? match[0].toLowerCase() : null;\nreturn [{\n  json: {\n    sessionId: input.sessionId,\n    email,\n    valid: Boolean(email) && email.length <= 254,\n    attempted: text.includes('@')\n  }\n}];"
      },
