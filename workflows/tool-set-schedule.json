      "parameters": {
        "jsCode": "const { user_id, send_time, timezone } = $input.first().json;\n\nconst time = String(send_time ?? '').trim();\nconst match = time.match(/^([01]?\\d|2[0-3]):([0-5]\\d)$/);\nif (!match) {\n  return [{ json: { ok: false, message: \"Heure invalide : elle doit être au format HH:MM, entre 00:00 et 23:59 (par exemple 08:00).\" } }];\n}\nconst sendTime = `${match[1].padStart(2, '0')}:${match[2]}`;\n\nconst tz = String(timezone ?? '').trim() || 'Europe/Paris';\ntry {\n  new Intl.DateTimeFormat('fr-FR', { timeZone: tz });\n} catch (e) {\n  return [{ json: { ok: false, message: `Fuseau horaire inconnu : « ${tz} ». Utilise un nom comme Europe/Paris ou America/New_York.` } }];\n}\n\nreturn [{ json: { ok: true, user_id, send_time: sendTime, timezone: tz } }];"
      },
