        "jsCode": "   const r = $input.first().json;\n\n   if (!r.send_time) {\n     return [{ json: { ok: false, message: \"Profil introuvable.\" } }];\n   }\n\n   const sendTime = String(r.send_time).slice(0, 5);\n   return [{\n     json: {\n       ok: true,\n       message: `Heure d'envoi réglée à ${sendTime} (${r.timezone}).`,\n       data: { send_time: sendTime, timezone: r.timezone }\n     }\n   }];"
